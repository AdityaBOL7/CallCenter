<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- SIM auto-dial places real carrier calls via the device SIM. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Watch the call state so SIM mode advances to disposition only after the
         carrier call actually ends (OFFHOOK → IDLE), not on any app resume. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- After a SIM-mode call, read the TRUE talk duration (and answered/busy
         outcome) from the device call log — telephony state can't tell pickup
         from ringing, so this is the only accurate source for SIM calls. Play
         "restricted permission": declared as a dialer/call-management core use;
         the feature degrades gracefully (approx duration) if it's denied. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Local callback reminders (no FCM): post notifications, exact alarms, and
         re-arm alarms after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Send the optional after-call SMS from the disposition screen. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Android 11+ package visibility: let us open WhatsApp / SMS / email apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".CallCenterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallCenter"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CallCenter.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Watches PHONE_STATE so a normal incoming SIM call is reported to the
             backend when it ends and (if answered) routed to the disposition
             screen. Manifest-registered so it works even if the app was killed;
             PHONE_STATE is a protected system broadcast, so exported is safe. -->
        <receiver
            android:name=".telephony.IncomingCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Fires when a callback reminder alarm goes off → posts a notification. -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- Re-arms reminder alarms after a device reboot (alarms don't survive it). -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
