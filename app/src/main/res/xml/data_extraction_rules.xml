<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Auth tokens must never leave the device via cloud backup. -->
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <!-- ...nor via device-to-device transfer. -->
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>